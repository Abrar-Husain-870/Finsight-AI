# Application Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/finsight"

# Cryptographic & Session Secrets (32-byte hexadecimal or secure strings)
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
ENCRYPTION_KEY="your-32-byte-hex-string-for-aes-256-vault"

# AI Intelligence Engine (Groq / Cloud LLM)
GROQ_API_KEY="gsk_your_groq_api_key_here"
DEFAULT_AI_PROVIDER="groq"
DEFAULT_AI_MODEL="qwen/qwen3.8-27b"

# Optional OAuth 2.0 Providers (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
